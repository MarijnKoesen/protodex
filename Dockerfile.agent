# Environment for running the forge agent on Go projects.
# Includes make and a C toolchain (needed for `go test -race`, which requires cgo),
# plus golangci-lint, so build, test and lint can all run in full.
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION}-bookworm

ARG GOLANGCI_LINT_VERSION=v2.15.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        make \
        gcc \
        libc6-dev \
        git \
        ca-certificates \
        curl \
        jq \
    && rm -rf /var/lib/apt/lists/*

# Linter
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh \
    | sh -s -- -b /usr/local/bin ${GOLANGCI_LINT_VERSION}

# cgo must be on for the race detector
ENV CGO_ENABLED=1 \
    GOFLAGS=-buildvcs=false

WORKDIR /workspace

CMD ["bash"]
