# SPDX-License-Identifier: Apache-2.0
# Copy to deploy/.env and change every secret before exposing the stack.
# deploy/.env is git-ignored. All values below are development defaults.

# Image to run. Leave unset to build from the repository checkout
# (`docker compose up --build`) or pull the latest release.
# PROTODEX_IMAGE=ghcr.io/marijnkoesen/protodex:v0.1.0

PROTODEX_PORT=8080
PROTODEX_LOG_LEVEL=info

# Bootstrap admin token (forward-looking: used once token auth lands).
# Generate one with: openssl rand -hex 32
PROTODEX_BOOTSTRAP_ADMIN_TOKEN=protodex-dev-admin-token

# MinIO credentials (also used by protodex as its S3 credentials).
MINIO_ROOT_USER=protodex
MINIO_ROOT_PASSWORD=protodex-dev-secret
MINIO_CONSOLE_PORT=9001
PROTODEX_S3_BUCKET=protodex

# Override MinIO images (MinIO stopped publishing new community images in
# late 2025; point these at a mirror or alternative S3 server if needed).
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
