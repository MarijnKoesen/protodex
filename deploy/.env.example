# SPDX-License-Identifier: Apache-2.0
# Copy to deploy/.env and change every secret before exposing the stack.
# deploy/.env is git-ignored. All values below are development defaults.

# Image to run. Leave unset to build from the repository checkout
# (`docker compose up --build`) or pull the latest release.
# PROTODEX_IMAGE=ghcr.io/marijnkoesen/protodex:v0.1.0

PROTODEX_PORT=8080
PROTODEX_LOG_LEVEL=info

# The admin token comes from `protodex bootstrap` (see deploy/README.md),
# not from this file.

# S3 credentials: the SeaweedFS gateway admin identity, also used by protodex.
S3_ACCESS_KEY=protodex
S3_SECRET_KEY=protodex-dev-secret
PROTODEX_S3_BUCKET=protodex

# Override the SeaweedFS image (defaults to chrislusf/seaweedfs:latest; pin a
# release tag for reproducible deployments).
# SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
