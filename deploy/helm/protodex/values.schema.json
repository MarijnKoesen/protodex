{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "protodex Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "mode": {
      "type": "string",
      "description": "Storage mode. Only sqlite (single replica, Recreate) exists today.",
      "enum": [
        "sqlite"
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "description": "Image digest; takes precedence over tag.",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "description": "protodex image"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ]
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ]
        },
        "maxRequestBytes": {
          "type": "integer",
          "description": "PROTODEX_MAX_REQUEST_BYTES",
          "minimum": 1
        },
        "shutdownTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "tracing": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "otlpEndpoint": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "dbPath": {
          "type": "string",
          "description": "SQLite database path; its directory is the data volume mount.",
          "pattern": "^/.+/[^/]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "dbPath"
      ]
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "s3": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "Empty = AWS S3; ignored when seaweedfs.enabled.",
          "pattern": "^(https?://.+)?$"
        },
        "region": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "accessKeyId": {
          "type": "string"
        },
        "secretAccessKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "bootstrapAdminToken": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "existingSecret": {
      "type": "string",
      "description": "Name of a pre-existing Secret holding secretKeys."
    },
    "secretKeys": {
      "type": "object",
      "properties": {
        "s3AccessKeyId": {
          "type": "string",
          "minLength": 1
        },
        "s3SecretAccessKey": {
          "type": "string",
          "minLength": 1
        },
        "bootstrapAdminToken": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?|[mkMGTPE]|e[0-9]+)?$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "litestream": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "digest": {
              "type": "string",
              "description": "Image digest; takes precedence over tag.",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "description": "Litestream image"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "syncInterval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "nativeSidecar": {
          "type": "boolean",
          "description": "Run as a native sidecar (Kubernetes >= 1.29)."
        },
        "restore": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false,
          "description": "Container resources"
        },
        "extraConfig": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "seaweedfs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "digest": {
              "type": "string",
              "description": "Image digest; takes precedence over tag.",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "description": "SeaweedFS image"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?|[mkMGTPE]|e[0-9]+)?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "volumeSizeLimitMB": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false,
          "description": "Container resources"
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "tmpSizeLimit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?|[mkMGTPE]|e[0-9]+)?$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "description": "Container resources"
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timeouts": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "litestream": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "properties": {
            "allowAll": {
              "type": "boolean"
            },
            "s3To": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "s3Ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "extraRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
